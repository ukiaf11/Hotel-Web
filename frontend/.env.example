# Leave VITE_API_URL empty (or omit this file) to run against the built-in
# in-browser demo backend — this is how the public demo deployment runs.
#
# Point it at a deployed Django instance to use the real API:
# VITE_API_URL=https://hotel-web-api.onrender.com
VITE_API_URL=

# --- Order email in demo mode -------------------------------------------------
# With no Django backend there is no SMTP, so the demo can optionally deliver the
# two order emails through EmailJS, which is designed to be called from a browser
# (its public key is meant to be public). Free tier: ~200 emails/month.
#
#   1. Sign up at https://www.emailjs.com and add an email service.
#   2. Create a template whose body uses {{subject}} and {{message}}, and set its
#      "To email" to {{to_email}} and "Reply-To" to {{reply_to}}.
#   3. Copy the three ids below and add your site's origin to the allowed list.
#
# Leave these blank and the demo records each composed message in the in-app
# outbox (/outbox) instead of sending it — the feature stays fully inspectable.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
