DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Postgres in production; omit to fall back to SQLite for local development.
# DATABASE_URL=postgres://user:password@host:5432/hotel_db

# Celery / cache broker; omit to run tasks eagerly in-process.
# REDIS_URL=redis://localhost:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

JWT_SECRET=change-me-too
JWT_ACCESS_TTL_MINUTES=720
JWT_REFRESH_TTL_DAYS=14

PLATFORM_TAX_RATE=0.05

# --- Order email --------------------------------------------------------------
# Two messages go out when an order is placed: a kitchen ticket to the distributor
# and a confirmation to the customer. With EMAIL_HOST unset Django uses the console
# backend, so the feature works in development without any credentials.
#
# Gmail (free, 500/day) — requires 2FA plus an App Password, not your login password:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=true
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-char-app-password
#
# Brevo (free, 300/day):   EMAIL_HOST=smtp-relay.brevo.com  EMAIL_PORT=587
# Resend (free, 100/day):  EMAIL_HOST=smtp.resend.com       EMAIL_PORT=587  EMAIL_HOST_USER=resend
#
# To inspect rendered mail on disk instead of sending it:
#   EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
#   EMAIL_FILE_PATH=./sent_emails
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Hotel Express <no-reply@hotelexpress.dev>

ORDER_EMAILS_ENABLED=true
ORDER_EMAIL_TO_DISTRIBUTOR=true
ORDER_EMAIL_TO_CUSTOMER=true

# Used for absolute links inside emails (track order, order queue).
FRONTEND_URL=https://ukiaf11.github.io/Hotel-Web
